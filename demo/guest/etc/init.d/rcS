#!/bin/sh
set -eu

# The ext4 root supplies writable storage alongside the kernel filesystems.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
if ! mountpoint -q /dev; then
    mount -t devtmpfs devtmpfs /dev
fi
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

# Host operations stay visible through the uncached resident 9p mount.
hostname riscbox
ip link set lo up
mount -t 9p -o trans=virtio,version=9p2000.L,cache=none,access=1000,uname=riscbox shared /shared
acpid
