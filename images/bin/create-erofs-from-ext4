#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: $0 INPUT.ext4 OUTPUT.erofs" >&2
    exit 2
fi

source_image=$1
output_image=$2
if [ ! -f "$source_image" ]; then
    echo "missing ext4 image: $source_image" >&2
    exit 1
fi
if ! command -v mkfs.erofs >/dev/null 2>&1; then
    echo "mkfs.erofs is required (install erofs-utils)" >&2
    exit 1
fi

# The setup image remains writable ext4. Mount its finished contents read-only
# so mkfs.erofs preserves guest ownership, modes, links, and device nodes.
mount_dir=$(mktemp -d)
image_part="$output_image.part"
mounted=false
cleanup() {
    if [ "$mounted" = true ]; then
        sudo -n umount "$mount_dir"
    fi
    rmdir "$mount_dir"
    sudo -n rm -f "$image_part"
}
trap cleanup EXIT HUP INT TERM

sudo -n mount -o loop,ro "$source_image" "$mount_dir"
mounted=true
sudo -n mkfs.erofs "$image_part" "$mount_dir"
sudo -n chown "$(id -u):$(id -g)" "$image_part"
mv "$image_part" "$output_image"
