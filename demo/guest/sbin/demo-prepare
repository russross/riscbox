#!/bin/sh
set -eu

# Preparation runs entirely inside QEMU's initramfs, with a writable output share.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /mnt/source /mnt/output
mount -t 9p -o trans=virtio,version=9p2000.L source /mnt/source
mount -t 9p -o trans=virtio,version=9p2000.L output /mnt/output
trap 'echo "guest preparation failed" > /mnt/output/failed; poweroff -f' EXIT
ip link set eth0 up
udhcpc -q -n -i eth0
apk add --no-cache tcc tcc-libs-static musl-dev make doas nano less \
    ncurses-dev ncurses-terminfo-base cracklib-words

# Hangman reads plain text; retain the package's dictionary and license metadata.
mkdir -p /usr/share/dict
gzip -dc /usr/share/cracklib/cracklib-words.gz > /usr/share/dict/words

# The image contains tools, while independently loaded source trees stay on 9p.
cp -R /mnt/source/bsd-games-3.3 /tmp/examples
make -C /tmp/examples clean
make -C /tmp/examples
printf 'Hello\n' | /tmp/examples/caesar/caesar 13 | grep -q 'Uryyb'
printf 'q\n' | /tmp/examples/wump/wump | grep -q 'Wumpus'
/tmp/examples/arithmetic/arithmetic </dev/null | grep -q ' = '

addgroup -g 1000 demo
adduser -D -u 1000 -G demo -h /home/demo demo
passwd -d demo
passwd -l root
mkdir -p /workspace /dev/pts /run /proc /sys /tmp /mnt /home/demo
chown demo:demo /workspace /home/demo
chmod 1777 /tmp
chmod 600 /etc/doas.conf
printf '/dev/vda / erofs ro,noatime 0 0\n' > /etc/fstab

# Export only the prepared filesystem, retaining guest ownership and permissions.
rm -rf /tmp/examples /var/cache/apk/*
rm -f /sbin/demo-prepare
tar -C / -cf /mnt/output/rootfs.tar \
    --exclude='./dev/*' --exclude='./proc/*' --exclude='./sys/*' \
    --exclude='./tmp/*' --exclude='./run/*' --exclude='./mnt/*' \
    ./bin ./dev ./etc ./home ./lib ./mnt ./proc ./root ./run ./sbin ./sys ./tmp ./usr ./var ./workspace
tar -tf /mnt/output/rootfs.tar | grep -q '^./usr/include/sys/types.h$'
touch /mnt/output/complete
trap - EXIT
sync
poweroff -f
