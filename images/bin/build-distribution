#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
IMAGES_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
ROOT_DIR=$(CDPATH= cd -- "$IMAGES_DIR/.." && pwd)
KERNEL_IMAGE=${KERNEL_IMAGE:-"$ROOT_DIR/kernel/linux"}
BOOT_PAYLOAD=${BOOT_PAYLOAD:-"$KERNEL_IMAGE"}
BOOT_PAYLOAD_NAME=${BOOT_PAYLOAD_NAME:-linux}
OPENSBI=${OPENSBI:-"$ROOT_DIR/opensbi/fw_dynamic.bin"}

case "$BOOT_PAYLOAD_NAME" in
    linux|u-boot.bin) ;;
    *) echo "unsupported boot payload name: $BOOT_PAYLOAD_NAME" >&2; exit 2 ;;
esac

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ] ||
    { [ "$#" -eq 3 ] && [ "$3" != --erofs ]; }; then
    echo "usage: $0 IMAGE_DIRECTORY ROOTFS.ext4 [--erofs]" >&2
    exit 2
fi

image_dir=$(CDPATH= cd -- "$1" && pwd)
rootfs_image=$2
output_dir="$image_dir/dist"
mkdir -p "$image_dir/build"

for required_file in "$image_dir/riscbox.cfg" "$rootfs_image" \
    "$BOOT_PAYLOAD" "$OPENSBI" "$IMAGES_DIR/DEPLOYMENT.md"; do
    if [ ! -f "$required_file" ]; then
        echo "missing required file: $required_file" >&2
        exit 1
    fi
done

if [ "${3:-}" = --erofs ]; then
    distribution_image="$image_dir/build/rootfs.erofs"
    if [ ! -f "$distribution_image" ] || [ "$rootfs_image" -nt "$distribution_image" ] || \
        [ "$SCRIPT_DIR/create-erofs-from-ext4" -nt "$distribution_image" ]; then
        "$SCRIPT_DIR/create-erofs-from-ext4" "$rootfs_image" "$distribution_image"
    fi
else
    distribution_image=$rootfs_image
fi

make -C "$ROOT_DIR" wasm js

if [ -d "$image_dir/ui" ]; then
    if [ ! -d "$image_dir/ui/node_modules" ] || \
        [ "$image_dir/ui/package-lock.json" -nt "$image_dir/ui/node_modules/.package-lock.json" ]; then
        npm --prefix "$image_dir/ui" ci
    fi
    npm --prefix "$image_dir/ui" run check
    npm --prefix "$image_dir/ui" run build
fi

stage_dir=$(mktemp -d "$image_dir/build/dist.XXXXXX")
cleanup() {
    rm -rf "$stage_dir"
}
trap cleanup EXIT HUP INT TERM

kernel_name=$BOOT_PAYLOAD_NAME-$(sha256sum "$BOOT_PAYLOAD" | cut -c 1-8).gz
bios_name=fw_dynamic.bin-$(sha256sum "$OPENSBI" | cut -c 1-8).gz
gzip -9 -n -c "$BOOT_PAYLOAD" > "$stage_dir/$kernel_name"
chmod 644 "$stage_dir/$kernel_name"
gzip -9 -n -c "$OPENSBI" > "$stage_dir/$bios_name"
chmod 644 "$stage_dir/$bios_name"
install -m 644 "$ROOT_DIR/build/js/riscbox.js" "$stage_dir/riscbox.js"
install -m 644 "$ROOT_DIR/build/js/riscbox.d.ts" "$stage_dir/riscbox.d.ts"
mkdir -p "$stage_dir/network"
for network_module in "$ROOT_DIR/build/js/network/"*.js "$ROOT_DIR/build/js/network/"*.d.ts; do
    install -m 644 "$network_module" "$stage_dir/network/$(basename "$network_module")"
done
install -m 644 "$ROOT_DIR/js/network/README.md" "$stage_dir/network/README.md"
install -m 644 "$ROOT_DIR/target/wasm32-unknown-unknown/release/riscbox_wasm.wasm" \
    "$stage_dir/riscbox.wasm"
install -m 644 "$IMAGES_DIR/DEPLOYMENT.md" "$stage_dir/README.md"
install -m 644 "$IMAGES_DIR/web/index.html" "$stage_dir/index.html"
if [ -d "$image_dir/web" ]; then
    cp -R "$image_dir/web/." "$stage_dir/"
fi
if [ -f "$image_dir/build/ui/bundle.js" ]; then
    for built_javascript in "$image_dir/build/ui/"*.js "$image_dir/build/ui/"*.wasm; do
        [ -f "$built_javascript" ] || continue
        install -m 644 "$built_javascript" "$stage_dir/$(basename "$built_javascript")"
    done
fi
if [ -d "$image_dir/examples" ]; then
    cp -R "$image_dir/examples" "$stage_dir/examples"
    if [ -f "$image_dir/examples/examples.json" ]; then
        "$ROOT_DIR/tools/image_deployment.py" examples \
            "$image_dir/examples/examples.json" "$stage_dir/examples/examples.json"
    fi
fi
split_result=$("$ROOT_DIR/tools/splitimg.py" "$distribution_image" "$stage_dir")
drive_name=${split_result%% *}
"$ROOT_DIR/tools/image_deployment.py" rewrite \
    "$image_dir/riscbox.cfg" "$stage_dir/riscbox.cfg" \
    "$bios_name" "$kernel_name" "$drive_name"

mkdir -p "$output_dir"
for staged_asset in "$stage_dir"/*; do
    asset_name=$(basename "$staged_asset")
    if [ "$asset_name" = riscbox.cfg ]; then
        continue
    fi
    if [ -d "$staged_asset" ]; then
        case "$asset_name" in
            drive-*)
                if [ ! -d "$output_dir/$asset_name" ]; then
                    mv "$staged_asset" "$output_dir/$asset_name"
                fi
                ;;
            *)
                rm -rf "$output_dir/$asset_name"
                mv "$staged_asset" "$output_dir/$asset_name"
                ;;
        esac
    else
        case "$asset_name" in
            linux-*|u-boot.bin-*|fw_dynamic.bin-*)
                if [ ! -f "$output_dir/$asset_name" ]; then
                    mv "$staged_asset" "$output_dir/$asset_name"
                fi
                ;;
            *)
                install -m 644 "$staged_asset" "$output_dir/$asset_name"
                ;;
        esac
    fi
done
install -m 644 "$stage_dir/riscbox.cfg" "$output_dir/.riscbox.cfg.new"
mv "$output_dir/.riscbox.cfg.new" "$output_dir/riscbox.cfg"
trap - EXIT HUP INT TERM
rm -rf "$stage_dir"
echo "deployment: $output_dir"
